# — Supabase —
# Obtené estos valores en: https://supabase.com → proyecto → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://teibonnocqujikxbytzl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-publishable-key-aca
SUPABASE_SERVICE_ROLE_KEY=tu-secret-key-aca

# — App —
NEXT_PUBLIC_APP_URL=http://localhost:3000

# — Chatbot de consultas (Anthropic) —
# Obtené la key en: https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=tu-api-key-aca

# — Reportes CSV para Google Sheets (ej. /api/reportes/recaudacion-diaria) —
# Token propio, cualquier string largo y random. Va en la URL: ?token=...
REPORTES_TOKEN=tu-token-random-aca

# — Notificaciones push del chat (Web Push / VAPID) —
# Se generan una sola vez con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu-public-key-aca
VAPID_PRIVATE_KEY=tu-private-key-aca
# Contacto del remitente, requerido por el protocolo Web Push.
VAPID_SUBJECT=mailto:tu-email@diagnotest.com.ar